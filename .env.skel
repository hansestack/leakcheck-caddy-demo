# Hansestack Leak-Check API
HANSESTACK_API_KEY=your-hansestack-api-key-here

# Public site address for the edge-proxy. Locally, leave this as
# "http://localhost" (plaintext, no TLS). In production, set it to your
# real domain with no scheme, e.g. "demo.hansestack.de" -- Caddy then
# automatically obtains and renews a Let's Encrypt certificate and serves
# HTTPS for you, with no other config change required.
SITE_ADDRESS=http://localhost

# Rate limit applied at the edge to /login, protecting the shared/sponsored
# Hansestack SaaS API key from being exhausted or abused by any single
# client. events per window, keyed per remote host.
RATE_LIMIT_EVENTS=10
RATE_LIMIT_WINDOW=1m

# Optional: per-request timeout
# HANSESTACK_TIMEOUT=500ms

# Optional: circuit breaker
# HANSESTACK_CIRCUIT_BREAKER_THRESHOLD=5
# HANSESTACK_CIRCUIT_BREAKER_COOLDOWN=30s

# Optional: max idle connections kept alive in the underlying HTTP client's
# connection pool to the Hansestack API. Caps how far TCP socket usage can
# grow under a login traffic spike, instead of opening one new connection
# per concurrent leak check.
# HANSESTACK_MAX_IDLE_CONNS=200

TZ=Europe/Berlin
