{
  "id": null,
  "uid": "hansestack-demo",
  "title": "Hansestack Leak-Check Demo",
  "description": "All single-number stat tiles below are totals over the currently selected time range (see the time picker, top right). Widen or narrow it to see more or less history. The Indicator of Compromise (IoC) row correlates leak-check verdicts with the backend's own HTTP response, surfacing Confirmed/Defeated ATOs.",
  "tags": ["caddy", "hansestack", "leakcheck", "ioc", "ato"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 4,
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 100,
      "title": "Traffic Overview",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "title": "Caddy HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(rate(caddy_http_requests_total[1m])) by (code)",
          "legendFormat": "HTTP {{code}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Caddy HTTP Request Duration (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "title": "Leak-Check Verdicts Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(rate(hansestack_leakcheck_checks_total[1m])) by (result)",
          "legendFormat": "{{result}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Leak-Check Outcomes Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(rate(hansestack_leakcheck_check_outcomes_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 104,
      "title": "🚨 Indicator of Compromise (IoC)",
      "type": "row",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": []
    },
    {
      "id": 105,
      "title": "🚨 Confirmed ATOs (Leaked + 2xx)",
      "description": "hansestack_leakcheck_responses_total{result=\"leaked\", status_class=\"2xx\"} — the single most actionable series this plugin exposes: a password confirmed to be in a known breach nonetheless reached the backend and got a successful response, i.e. someone logged in with a known-leaked credential. Recorded in every mode (including observe), not just block.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(increase(hansestack_leakcheck_responses_total{result=\"leaked\", status_class=\"2xx\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "#C4162B", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 106,
      "title": "🛡️ Defeated ATOs (Leaked + 4xx)",
      "description": "hansestack_leakcheck_responses_total{result=\"leaked\", status_class=\"4xx\"} — a leaked-password login attempt that the backend (or Caddy in mode=block) rejected with a 4xx. Only ever nonzero when something in the chain actually stops a confirmed-leaked credential from succeeding — enrich_response/enrich_request/observe never block on their own, so this is mode-dependent.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(increase(hansestack_leakcheck_responses_total{result=\"leaked\", status_class=\"4xx\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 107,
      "title": "Leaked, Fail-Open Skipped",
      "description": "hansestack_leakcheck_responses_total{result=\"skipped\"} — the leak check itself was skipped (fail-open: timeout, rate limit, circuit open, client error, or canceled — see the Fail-Open Outcomes row below for the detailed reason) but the backend response was still recorded here for IoC correlation, bucketed by status_class.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(increase(hansestack_leakcheck_responses_total{result=\"skipped\"}[$__range]))",
          "instant": true,
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value_and_name",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 108,
      "title": "Response Correlation (IoC Breakdown)",
      "description": "hansestack_leakcheck_responses_total grouped by result and status_class — correlates every leak-check verdict (leaked/not_leaked/skipped) with the backend's actual HTTP response class (2xx/3xx/4xx/5xx/unknown). A rising leaked/2xx series here is the same signal as the red 'Confirmed ATOs' tile above, over time.",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "VictoriaMetrics" },
      "targets": [
        {
          "expr": "sum(rate(hansestack_leakcheck_responses_total[1m])) by (result, status_class)",
          "legendFormat": "{{result}} / {{status_class}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "leaked / 2xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "#C4162B" } }]
          },
          {
            "matcher": { "id": "byName", "options": "leaked / 4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }]
          },
          {
            "matcher": { "id": "byName", "options": "leaked / 5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "leaked / 3xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "semi-dark-red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "leaked / unknown" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_leaked / 2xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_leaked / 3xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_leaked / 4xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "purple" } }]
          },
          {
            "matcher": { "id": "byName", "options": "not_leaked / 5xx" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "dark-purple" } }]
          },
          {
            "matcher": { "id": "byRegexp", "options": "^skipped / .*" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "gray" } }]
          }
        ]
      }
    },
    {
